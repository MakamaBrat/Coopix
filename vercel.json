{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": { "api/*.js": { "maxDuration": 15 } },
  "rewrites": [
    { "source": "/api/subs/:id/file", "destination": "/api/subs?id=:id&file=1" },
    { "source": "/api/subs/:id", "destination": "/api/subs?id=:id" },
    { "source": "/:game((?!api$|assets$|admin)[A-Za-z0-9_-]{1,40})", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] },
    { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/admin.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "X-Robots-Tag", "value": "noindex" } ] },
    { "source": "/assets/config.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/assets/fonts/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/assets/music/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" } ] },
    { "source": "/assets/spr/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/assets/coopix-pigeon.png", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" } ] },
    { "source": "/api/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
  ]
}
