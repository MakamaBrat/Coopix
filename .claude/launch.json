      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path'),r=p.resolve('public'),T={'.html':'text/html; charset=utf-8','.js':'text/javascript','.png':'image/png','.css':'text/css','.mp3':'audio/mpeg','.svg':'image/svg+xml','.json':'application/json','.woff2':'font/woff2'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.startsWith('/api')){s.writeHead(404);return s.end('{}')}let fp=p.join(r,u==='/'?'index.html':u);if(!fp.startsWith(r)||!f.existsSync(fp)||f.statSync(fp).isDirectory()){s.writeHead(404);return s.end()}s.writeHead(200,{'content-type':T[p.extname(fp)]||'application/octet-stream'});f.createReadStream(fp).pipe(s)}).listen(5178)"],
